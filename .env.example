# Rijksmuseum — currently unavailable. The classic keyed API is deprecated and
# key issuance has been retired from Rijksstudio settings; the keyless
# replacement returns only Linked-Art IRIs (no direct images). The adapter
# self-disables without a key, so the app runs on AIC + CMA + Met. Leave blank.
RIJKSMUSEUM_API_KEY=

# Harvard Art Museums — free key, issued by the form at
# https://harvardartmuseums.org/collections/api (pick "API Token", arrives by
# email). The adapter self-disables without one; set it and add "harvard" to
# ALL_SOURCES in src/app/page.tsx to light it up. 2,500 requests/day.
HARVARD_API_KEY=

# LLM for the curator panel and "interpret" search. Two engines, chosen
# automatically (src/lib/engine.ts):
#   • Local `npm run dev`  → the Claude Agent SDK (spawns the `claude` CLI,
#     auth from your logged-in profile or ANTHROPIC_API_KEY). No env needed
#     here if you're already logged into Claude locally.
#   • Vercel / any serverless host → OpenRouter (below), since the SDK can't
#     spawn a subprocess there.
# Force one either way with LOUPE_LLM_ENGINE=claude|openrouter.
# Manual search, categories, calm scoring, collections and export need no LLM.

# OpenRouter key — used by the hosted engine. Its `:free` models cost $0/token
# but are rate-limited: 20 req/min, and 50 req/day until you've added $10 of
# credits (once, ever) — then 1,000 req/day. A curator turn is up to 8
# requests, so the $10 top-up is what makes it usable for visitors. Get a key
# at https://openrouter.ai/keys — and in Settings → Privacy allow providers
# that may train on inputs, or the free models return 404.
OPENROUTER_API_KEY=

# Optional overrides. Model vars take a comma-separated list: the first is
# primary, the rest are OpenRouter fallbacks tried when a free endpoint is busy.
# Pick any free model with image input + tool calling for the curator:
# https://openrouter.ai/models?q=free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=              # key for a non-OpenRouter endpoint (takes precedence)
# LOUPE_CURATOR_MODEL=minimax/minimax-m3:free,google/gemma-4-31b-it:free
# LOUPE_INTERPRET_MODEL=google/gemma-4-31b-it:free
