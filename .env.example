# Rijksmuseum — currently unavailable. The classic keyed API is deprecated and
# key issuance has been retired from Rijksstudio settings; the keyless
# replacement returns only Linked-Art IRIs (no direct images). The adapter
# self-disables without a key; the app runs on AIC, CMA, the Met, SMK and Mia. Leave blank.
RIJKSMUSEUM_API_KEY=

# Harvard Art Museums — free key, issued by the form at
# https://harvardartmuseums.org/collections/api (pick "API Token", arrives by
# email). The adapter self-disables without one; set it and add "harvard" to
# ALL_SOURCES in src/app/page.tsx to light it up. 2,500 requests/day.
HARVARD_API_KEY=

# LLM for Curio (the agent) and the "describe" route. Three engines
# (src/lib/ai/models.ts), the first two chosen automatically:
#   • claude — local `npm run dev`: a Claude Code session on your `claude
#     login` (ai-sdk-provider-claude-code). No env needed if you're logged in.
#   • openrouter — Vercel / any serverless host: OpenRouter (below).
#   • gateway — opt-in: the Vercel AI Gateway (AI_GATEWAY_API_KEY, or OIDC
#     on Vercel).
# Force one with CURIO_LLM_ENGINE=claude|openrouter|gateway.
# Search, categories, calm scoring, collections, export and the recorded
# homepage examples need no LLM.
# AI_GATEWAY_API_KEY=
# CURIO_LOCAL_MODEL=sonnet            # local Curio (Claude alias)
# CURIO_LOCAL_INTERPRET_MODEL=haiku   # local describe
# CURIO_ROUTER=jev                    # route with Jev via the Gateway (experimental; off)

# OpenRouter key — used by the hosted engine. Get one at
# https://openrouter.ai/keys, add a little credit (Settings → Credits), and in
# Settings → Privacy allow providers that may train on inputs (some models 404
# otherwise). The default model is paid but cheap — see below.
OPENROUTER_API_KEY=

# Optional overrides. Model vars take a comma-separated list: the first is
# primary, the rest are OpenRouter `models` fallbacks.
# Default (in code): google/gemini-2.5-flash-lite,qwen/qwen3-vl-30b-a3b-instruct
#   — cheap PAID models (vision + tools), no daily request cap, ~$0.01 a
#   curator turn. This is the reliable choice for a public demo.
# To run at $0 instead, point these at `:free` models — but they share one
# per-account daily cap (50/day, or 1,000/day once $10 of credits has settled)
# that real traffic exhausts. Free vision+tool models: openrouter.ai/models?q=free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=              # key for a non-OpenRouter endpoint (takes precedence)
# CURIO_CURATOR_MODEL=google/gemini-2.5-flash-lite,qwen/qwen3-vl-30b-a3b-instruct
# CURIO_INTERPRET_MODEL=google/gemini-2.5-flash-lite
